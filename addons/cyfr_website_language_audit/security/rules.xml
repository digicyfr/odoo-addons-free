<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_website_audit_run_company" model="ir.rule">
        <field name="name">Website audit runs by company</field>
        <field name="model_id" ref="model_cyfr_website_audit_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_website_audit_issue_company" model="ir.rule">
        <field name="name">Website audit issues by company</field>
        <field name="model_id" ref="model_cyfr_website_audit_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_website_audit_issue_public_page" model="ir.rule">
        <field name="name">Website audit issues for currently public pages</field>
        <field name="model_id" ref="model_cyfr_website_audit_issue"/>
        <field name="domain_force">[('page_currently_public', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
