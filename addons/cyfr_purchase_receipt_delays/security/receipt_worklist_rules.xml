<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_receipt_worklist_owner_company" model="ir.rule">
        <field name="name">Receipt worklist: owner and allowed company</field>
        <field name="model_id" ref="model_cyfr_purchase_receipt_worklist"/>
        <field name="domain_force">[('owner_id', '=', user.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_receipt_worklist_line_owner_company" model="ir.rule">
        <field name="name">Receipt worklist row: owner and allowed company</field>
        <field name="model_id" ref="model_cyfr_purchase_receipt_worklist_line"/>
        <field name="domain_force">[('owner_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
