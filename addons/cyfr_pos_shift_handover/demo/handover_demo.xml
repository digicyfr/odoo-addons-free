<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Core POS demo closes this session through its own financial close path. -->
        <record id="demo_unclaimed_handover" model="cyfr.pos.handover">
            <field name="name">Furniture Shop: display cable and till checklist</field>
            <field name="source_session_id" ref="point_of_sale.pos_closed_session_2"/>
            <field name="created_by_id" ref="base.user_admin"/>
        </record>
        <record id="demo_overdue_task" model="cyfr.pos.handover.task">
            <field name="handover_id" ref="demo_unclaimed_handover"/>
            <field name="title">Replace display cable</field>
            <field name="priority">high</field>
            <field name="owner_id" ref="base.user_admin"/>
            <field name="due_at" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="state">open</field>
            <field name="note">Synthetic demo task; confirm the display before the next shift.</field>
        </record>
        <record id="demo_unassigned_task" model="cyfr.pos.handover.task">
            <field name="handover_id" ref="demo_unclaimed_handover"/>
            <field name="title">Review till checklist</field>
            <field name="priority">normal</field>
            <field name="state">open</field>
        </record>
    </data>
</odoo>
