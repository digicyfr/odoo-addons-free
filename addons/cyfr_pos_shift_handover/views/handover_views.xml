<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_shift_handover_list" model="ir.ui.view">
        <field name="name">cyfr.pos.handover.list</field>
        <field name="model">cyfr.pos.handover</field>
        <field name="arch" type="xml">
            <list string="Shift Handovers" delete="0">
                <field name="name"/>
                <field name="config_id"/>
                <field name="source_session_id"/>
                <field name="target_session_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'unclaimed'" decoration-success="state == 'acknowledged'"/>
                <field name="created_by_id" optional="hide"/>
                <field name="claimed_by_id" optional="hide"/>
                <field name="acknowledged_by_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_pos_shift_handover_form" model="ir.ui.view">
        <field name="name">cyfr.pos.handover.form</field>
        <field name="model">cyfr.pos.handover</field>
        <field name="arch" type="xml">
            <form string="Shift Handover" delete="0">
                <header>
                    <button name="action_claim" type="object" string="Claim Current Session" class="btn-primary" invisible="state != 'unclaimed'"/>
                    <button name="action_acknowledge" type="object" string="Acknowledge Receipt" class="btn-primary" invisible="state != 'claimed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="unclaimed,claimed,acknowledged"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <div class="o_stat_info"><span class="o_stat_text">Tasks</span></div>
                        </button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group string="Sessions">
                            <field name="source_session_id" readonly="id" domain="[('state', 'in', ['opened', 'closing_control', 'closed']), ('rescue', '=', False)]"/>
                            <field name="target_session_id" readonly="1"/>
                            <field name="config_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group string="People and Times">
                            <field name="created_by_id" readonly="1"/>
                            <field name="claimed_by_id" readonly="1"/>
                            <field name="claimed_at" readonly="1"/>
                            <field name="acknowledged_by_id" readonly="1"/>
                            <field name="acknowledged_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Operational Tasks">
                        <field name="task_ids" readonly="1">
                            <list create="0" delete="0">
                                <field name="title"/>
                                <field name="priority" widget="badge"/>
                                <field name="owner_id"/>
                                <field name="due_at"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pos_shift_handover_search" model="ir.ui.view">
        <field name="name">cyfr.pos.handover.search</field>
        <field name="model">cyfr.pos.handover</field>
        <field name="arch" type="xml">
            <search string="Shift Handovers">
                <field name="name"/>
                <field name="config_id"/>
                <field name="source_session_id"/>
                <filter name="unclaimed" string="Unclaimed" domain="[('state', '=', 'unclaimed')]"/>
                <filter name="awaiting_ack" string="Awaiting Acknowledgement" domain="[('state', '=', 'claimed')]"/>
                <group>
                    <filter name="group_config" string="Register" context="{'group_by': 'config_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_pos_shift_handover_task_list" model="ir.ui.view">
        <field name="name">cyfr.pos.handover.task.list</field>
        <field name="model">cyfr.pos.handover.task</field>
        <field name="arch" type="xml">
            <list string="Handover Tasks" delete="0">
                <field name="title"/>
                <field name="handover_id"/>
                <field name="priority" widget="badge"/>
                <field name="owner_id"/>
                <field name="due_at"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'" decoration-success="state == 'done'"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_pos_shift_handover_task_form" model="ir.ui.view">
        <field name="name">cyfr.pos.handover.task.form</field>
        <field name="model">cyfr.pos.handover.task</field>
        <field name="arch" type="xml">
            <form string="Handover Task" delete="0">
                <sheet>
                    <h1><field name="title"/></h1>
                    <group>
                        <group>
                            <field name="handover_id" readonly="id"/>
                            <field name="priority"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="due_at"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Operational details for the next shift"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pos_shift_handover_task_search" model="ir.ui.view">
        <field name="name">cyfr.pos.handover.task.search</field>
        <field name="model">cyfr.pos.handover.task</field>
        <field name="arch" type="xml">
            <search string="Handover Tasks">
                <field name="title"/>
                <field name="owner_id"/>
                <field name="handover_id"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('owner_id', '=', False)]"/>
                <group>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_pos_shift_handover" model="ir.actions.act_window">
        <field name="name">Shift Handovers</field>
        <field name="res_model">cyfr.pos.handover</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_shift_handover_search"/>
        <field name="context">{'create': False}</field>
    </record>
    <record id="action_pos_shift_handover_task" model="ir.actions.act_window">
        <field name="name">Handover Tasks</field>
        <field name="res_model">cyfr.pos.handover.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pos_shift_handover_task_search"/>
        <field name="context">{'search_default_overdue': 1, 'create': False}</field>
    </record>
    <menuitem id="menu_pos_shift_handover" name="Shift Handovers" parent="point_of_sale.menu_point_of_sale"
              action="action_pos_shift_handover" sequence="3" groups="point_of_sale.group_pos_user"/>
    <menuitem id="menu_pos_shift_handover_task" name="Overdue Handover Tasks" parent="point_of_sale.menu_point_of_sale"
              action="action_pos_shift_handover_task" sequence="4" groups="point_of_sale.group_pos_manager"/>
    <record id="view_pos_session_form_handover" model="ir.ui.view">
        <field name="name">pos.session.form.shift.handover</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_outgoing_handover" type="object" class="oe_stat_button" icon="fa-share-square-o"
                        invisible="rescue or state == 'opening_control'" groups="point_of_sale.group_pos_user">
                    <div class="o_stat_info"><span class="o_stat_text">Outgoing Handover</span></div>
                </button>
                <button name="action_open_incoming_handover" type="object" class="oe_stat_button" icon="fa-inbox"
                        invisible="rescue or state != 'opened'" groups="point_of_sale.group_pos_user">
                    <div class="o_stat_info"><span class="o_stat_text">Incoming Handovers</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
