<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_pos_handover_company" model="ir.rule">
        <field name="name">POS handover: allowed companies</field>
        <field name="model_id" ref="model_cyfr_pos_handover"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pos_handover_task_company" model="ir.rule">
        <field name="name">POS handover task: allowed companies</field>
        <field name="model_id" ref="model_cyfr_pos_handover_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
