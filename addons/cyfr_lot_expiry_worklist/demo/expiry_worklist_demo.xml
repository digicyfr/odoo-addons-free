<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_product" model="product.product">
        <field name="name">Demo Chilled Goods</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">lot</field>
        <field name="use_expiration_date" eval="True"/>
    </record>
    <record id="demo_location_a" model="stock.location">
        <field name="name">Demo Expiry Shelf A</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="demo_location_b" model="stock.location">
        <field name="name">Demo Expiry Shelf B</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="demo_owner" model="res.partner">
        <field name="name">Demo External Stock Owner</field>
    </record>
    <record id="demo_lot" model="stock.lot">
        <field name="name">DEMO-EXPIRY-001</field>
        <field name="product_id" ref="demo_product"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="expiration_date" eval="datetime.now() + timedelta(days=5)"/>
        <field name="alert_date" eval="datetime.now() - timedelta(days=1)"/>
        <field name="use_date" eval="datetime.now() + timedelta(days=2)"/>
        <field name="removal_date" eval="datetime.now() + timedelta(days=4)"/>
    </record>
    <record id="demo_quant_a" model="stock.quant">
        <field name="product_id" ref="demo_product"/>
        <field name="location_id" ref="demo_location_a"/>
        <field name="lot_id" ref="demo_lot"/>
        <field name="quantity" eval="5"/>
        <field name="reserved_quantity" eval="1"/>
    </record>
    <record id="demo_quant_b" model="stock.quant">
        <field name="product_id" ref="demo_product"/>
        <field name="location_id" ref="demo_location_b"/>
        <field name="lot_id" ref="demo_lot"/>
        <field name="quantity" eval="3"/>
    </record>
    <record id="demo_quant_owner" model="stock.quant">
        <field name="product_id" ref="demo_product"/>
        <field name="location_id" ref="demo_location_b"/>
        <field name="lot_id" ref="demo_lot"/>
        <field name="owner_id" ref="demo_owner"/>
        <field name="quantity" eval="2"/>
    </record>
    <record id="demo_quant_zero" model="stock.quant">
        <field name="product_id" ref="demo_product"/>
        <field name="location_id" ref="demo_location_a"/>
        <field name="lot_id" ref="demo_lot"/>
        <field name="owner_id" ref="demo_owner"/>
        <field name="quantity" eval="0"/>
    </record>
    <record id="demo_acknowledged_action" model="cyfr.lot.expiry.entry">
        <field name="company_id" ref="base.main_company"/>
        <field name="lot_id" ref="demo_lot"/>
        <field name="product_id" ref="demo_product"/>
        <field name="product_uom_id" eval="ref('uom.product_uom_unit')"/>
        <field name="location_id" ref="demo_location_a"/>
        <field name="owner_key" eval="0"/>
        <field name="on_hand" eval="5"/>
        <field name="reserved" eval="1"/>
        <field name="physical_unreserved" eval="4"/>
        <field name="stock_present" eval="True"/>
        <field name="expiration_date" eval="datetime.now() + timedelta(days=5)"/>
        <field name="alert_date" eval="datetime.now() - timedelta(days=1)"/>
        <field name="use_date" eval="datetime.now() + timedelta(days=2)"/>
        <field name="removal_date" eval="datetime.now() + timedelta(days=4)"/>
        <field name="expiry_state">within_horizon</field>
        <field name="observed_at" eval="datetime.now()"/>
        <field name="scan_horizon_days" eval="30"/>
        <field name="assigned_user_id" ref="base.user_admin"/>
        <field name="next_action">Check chilled goods</field>
        <field name="action_note">Confirm handling plan with the warehouse team.</field>
        <field name="status">acknowledged</field>
        <field name="acknowledged_by" ref="base.user_admin"/>
        <field name="acknowledged_at" eval="datetime.now()"/>
    </record>
    <record id="demo_negative_lot" model="stock.lot">
        <field name="name">DEMO-EXPIRY-NEGATIVE</field>
        <field name="product_id" ref="demo_product"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="expiration_date" eval="datetime.now() - timedelta(days=1)"/>
    </record>
    <record id="demo_negative_quant" model="stock.quant">
        <field name="product_id" ref="demo_product"/>
        <field name="location_id" ref="demo_location_b"/>
        <field name="lot_id" ref="demo_negative_lot"/>
        <field name="quantity" eval="-1"/>
    </record>
    <record id="demo_second_company" model="res.company">
        <field name="name">Demo Expiry Second Company</field>
    </record>
    <record id="demo_second_location" model="stock.location">
        <field name="name">Demo Second Company Shelf</field>
        <field name="usage">internal</field>
        <field name="company_id" ref="demo_second_company"/>
    </record>
    <record id="demo_second_lot" model="stock.lot">
        <field name="name">DEMO-EXPIRY-SECOND</field>
        <field name="product_id" ref="demo_product"/>
        <field name="company_id" ref="demo_second_company"/>
        <field name="expiration_date" eval="datetime.now() + timedelta(days=7)"/>
    </record>
    <record id="demo_second_quant" model="stock.quant">
        <field name="product_id" ref="demo_product"/>
        <field name="location_id" ref="demo_second_location"/>
        <field name="lot_id" ref="demo_second_lot"/>
        <field name="quantity" eval="1"/>
    </record>
    <record id="demo_second_company_action" model="cyfr.lot.expiry.entry">
        <field name="company_id" ref="demo_second_company"/>
        <field name="lot_id" ref="demo_second_lot"/>
        <field name="product_id" ref="demo_product"/>
        <field name="product_uom_id" eval="ref('uom.product_uom_unit')"/>
        <field name="location_id" ref="demo_second_location"/>
        <field name="owner_key" eval="0"/>
        <field name="on_hand" eval="1"/>
        <field name="physical_unreserved" eval="1"/>
        <field name="stock_present" eval="True"/>
        <field name="expiration_date" eval="datetime.now() + timedelta(days=7)"/>
        <field name="expiry_state">within_horizon</field>
        <field name="observed_at" eval="datetime.now()"/>
        <field name="scan_horizon_days" eval="30"/>
        <field name="status">open</field>
    </record>
</odoo>
