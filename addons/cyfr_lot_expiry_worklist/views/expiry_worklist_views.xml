<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lot_expiry_entry_list" model="ir.ui.view">
        <field name="name">cyfr.lot.expiry.entry.list</field>
        <field name="model">cyfr.lot.expiry.entry</field>
        <field name="arch" type="xml">
            <list string="Lot Expiry Worklist" create="0" edit="0" delete="0" sample="0"
                  decoration-danger="expiry_state == 'expired' and stock_present"
                  decoration-muted="not stock_present">
                <field name="expiry_state"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="owner_id" optional="show"/>
                <field name="expiration_date"/>
                <field name="alert_date" optional="hide"/>
                <field name="on_hand"/>
                <field name="reserved" optional="hide"/>
                <field name="physical_unreserved" optional="hide"/>
                <field name="product_uom_id" optional="hide"/>
                <field name="stock_present" optional="hide"/>
                <field name="assigned_user_id"/>
                <field name="status"/>
                <field name="observed_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_lot_expiry_entry_form" model="ir.ui.view">
        <field name="name">cyfr.lot.expiry.entry.form</field>
        <field name="model">cyfr.lot.expiry.entry</field>
        <field name="arch" type="xml">
            <form string="Lot Expiry Action" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_assign" type="object" string="Assign Action"
                            class="btn-primary" groups="stock.group_stock_manager"/>
                    <button name="action_acknowledge" type="object" string="Acknowledge"
                            invisible="status != 'assigned'" groups="stock.group_stock_user"/>
                    <button name="action_open_lot" type="object" string="Open Native Lot"/>
                    <button name="action_open_quants" type="object" string="Current Quants"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Stock Position">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="owner_id"/>
                            <field name="stock_present"/>
                        </group>
                        <group string="Last Scan Snapshot">
                            <field name="on_hand"/>
                            <field name="reserved"/>
                            <field name="physical_unreserved"/>
                            <field name="product_uom_id"/>
                            <field name="observed_at"/>
                            <field name="scan_horizon_days"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Physical unreserved is on hand minus reserved at the last scan. Native available quantity can be zero after the removal date. This action does not move or scrap stock.
                    </div>
                    <group string="Native Lot Dates">
                        <field name="expiry_state"/>
                        <field name="expiration_date"/>
                        <field name="alert_date"/>
                        <field name="use_date"/>
                        <field name="removal_date"/>
                    </group>
                    <group string="Action and Acknowledgment">
                        <field name="assigned_user_id"/>
                        <field name="next_action"/>
                        <field name="action_note"/>
                        <field name="acknowledged_by"/>
                        <field name="acknowledged_at"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_lot_expiry_entry_search" model="ir.ui.view">
        <field name="name">cyfr.lot.expiry.entry.search</field>
        <field name="model">cyfr.lot.expiry.entry</field>
        <field name="arch" type="xml">
            <search string="Search Lot Expiry Actions">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="owner_id"/>
                <field name="assigned_user_id"/>
                <filter name="present" string="Present at Last Scan" domain="[('stock_present', '=', True)]"/>
                <filter name="absent" string="No Longer Present" domain="[('stock_present', '=', False)]"/>
                <filter name="expired" string="Expired at Last Scan" domain="[('expiry_state', '=', 'expired')]"/>
                <filter name="acknowledged" string="Acknowledged" domain="[('status', '=', 'acknowledged')]"/>
                <group>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_owner" string="Stock Owner" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_assignee" string="Responsible User" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_lot_expiry_entry_pivot" model="ir.ui.view">
        <field name="name">cyfr.lot.expiry.entry.pivot</field>
        <field name="model">cyfr.lot.expiry.entry</field>
        <field name="arch" type="xml">
            <pivot string="Lot Expiry Worklist">
                <field name="location_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="lot_id" type="row"/>
                <field name="owner_id" type="row"/>
                <field name="on_hand" type="measure"/>
                <field name="reserved" type="measure"/>
                <field name="physical_unreserved" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_lot_expiry_scan_form" model="ir.ui.view">
        <field name="name">cyfr.lot.expiry.scan.form</field>
        <field name="model">cyfr.lot.expiry.scan</field>
        <field name="arch" type="xml">
            <form string="Scan Lot Expiry">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="location_id" domain="[('usage', '=', 'internal'), ('active', '=', True), ('company_id', '=', company_id)]"/>
                    <field name="horizon_days"/>
                </group>
                <div class="alert alert-info" role="status">
                    One bounded scan checks at most 5,000 lot quants and 1,000 lot positions, including prior actions. If either limit is exceeded, the scan stops without changing the worklist; select a narrower location. The horizon compares the lot's expiration timestamp with current UTC time.
                </div>
                <footer>
                    <button name="action_scan" type="object" string="Scan" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_lot_expiry_assign_form" model="ir.ui.view">
        <field name="name">cyfr.lot.expiry.assign.form</field>
        <field name="model">cyfr.lot.expiry.assign</field>
        <field name="arch" type="xml">
            <form string="Assign Lot Action">
                <group>
                    <field name="entry_id" readonly="1"/>
                    <field name="assigned_user_id"/>
                    <field name="next_action"/>
                    <field name="action_note"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_lot_expiry_entry" model="ir.actions.act_window">
        <field name="name">Lot Expiry Worklist</field>
        <field name="res_model">cyfr.lot.expiry.entry</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_lot_expiry_entry_search"/>
    </record>
    <record id="action_lot_expiry_scan" model="ir.actions.act_window">
        <field name="name">Scan Lot Expiry</field>
        <field name="res_model">cyfr.lot.expiry.scan</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_lot_expiry_root" name="Lot Expiry" parent="stock.menu_stock_root"
              groups="stock.group_stock_user" sequence="36"/>
    <menuitem id="menu_lot_expiry_entries" name="Worklist" parent="menu_lot_expiry_root"
              action="action_lot_expiry_entry" groups="stock.group_stock_user" sequence="10"/>
    <menuitem id="menu_lot_expiry_scan" name="Scan" parent="menu_lot_expiry_root"
              action="action_lot_expiry_scan" groups="stock.group_stock_manager" sequence="20"/>
</odoo>
