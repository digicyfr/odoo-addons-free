<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_health_policy_company" model="ir.rule">
        <field name="name">Product health policy companies</field>
        <field name="model_id" ref="model_cyfr_product_health_policy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_health_scan_company" model="ir.rule">
        <field name="name">Product health scan companies</field>
        <field name="model_id" ref="model_cyfr_product_health_scan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_health_scan_reader_owner" model="ir.rule">
        <field name="name">Product health readers see their scans</field>
        <field name="model_id" ref="model_cyfr_product_health_scan"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_health_scan_manager_all" model="ir.rule">
        <field name="name">Product health managers see company scans</field>
        <field name="model_id" ref="model_cyfr_product_health_scan"/>
        <field name="groups" eval="[(4, ref('product.group_product_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_health_issue_company_product" model="ir.rule">
        <field name="name">Product health issue companies and products</field>
        <field name="model_id" ref="model_cyfr_product_health_issue"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('product_id.product_tmpl_id.company_id', '=', False), ('product_id.product_tmpl_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_health_issue_reader_current" model="ir.rule">
        <field name="name">Product health readers see current issues</field>
        <field name="model_id" ref="model_cyfr_product_health_issue"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('scan_id.is_current', '=', True)]</field>
    </record>
    <record id="rule_health_issue_manager_all" model="ir.rule">
        <field name="name">Product health managers see company history</field>
        <field name="model_id" ref="model_cyfr_product_health_issue"/>
        <field name="groups" eval="[(4, ref('product.group_product_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
