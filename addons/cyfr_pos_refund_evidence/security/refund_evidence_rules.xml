<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_refund_case_company" model="ir.rule">
        <field name="name">Refund evidence: allowed company</field>
        <field name="model_id" ref="model_cyfr_pos_refund_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_refund_case_cashier" model="ir.rule">
        <field name="name">Refund evidence: order cashier</field>
        <field name="model_id" ref="model_cyfr_pos_refund_case"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="domain_force">[('order_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_refund_case_manager" model="ir.rule">
        <field name="name">Refund evidence: manager company queue</field>
        <field name="model_id" ref="model_cyfr_pos_refund_case"/>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_refund_reason_company" model="ir.rule">
        <field name="name">Refund reasons: allowed company</field>
        <field name="model_id" ref="model_cyfr_pos_refund_reason"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
