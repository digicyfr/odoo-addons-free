<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_company_other" model="res.company">
        <field name="name">Cyfr Demo Second Company</field>
    </record>
    <record id="demo_won_stage" model="crm.stage">
        <field name="name">Cyfr Demo Won</field>
        <field name="is_won" eval="True"/>
    </record>
    <record id="demo_lead_no_activity" model="crm.lead">
        <field name="name">Cyfr Demo No Activity</field>
        <field name="type">lead</field>
    </record>
    <record id="demo_lead_planned" model="crm.lead">
        <field name="name">Cyfr Demo Planned Activity</field>
        <field name="type">opportunity</field>
    </record>
    <record id="demo_lead_overdue" model="crm.lead">
        <field name="name">Cyfr Demo Overdue Activity</field>
        <field name="type">opportunity</field>
    </record>
    <record id="demo_lead_won" model="crm.lead">
        <field name="name">Cyfr Demo Won Opportunity</field>
        <field name="type">opportunity</field>
        <field name="stage_id" ref="demo_won_stage"/>
        <field name="probability" eval="100"/>
    </record>
    <record id="demo_lead_lost" model="crm.lead">
        <field name="name">Cyfr Demo Lost Opportunity</field>
        <field name="type">opportunity</field>
        <field name="probability" eval="0"/>
        <field name="active" eval="False"/>
    </record>
    <record id="demo_lead_other_company" model="crm.lead">
        <field name="name">Cyfr Demo Other Company Lead</field>
        <field name="type">lead</field>
        <field name="company_id" ref="demo_company_other"/>
        <field name="user_id" eval="False"/>
    </record>
    <record id="demo_activity_planned" model="mail.activity">
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="demo_lead_planned"/>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="summary">Cyfr Demo Planned Call</field>
        <field name="date_deadline" eval="(datetime.now() + timedelta(days=7)).date().isoformat()"/>
    </record>
    <record id="demo_activity_overdue" model="mail.activity">
        <field name="res_model_id" ref="crm.model_crm_lead"/>
        <field name="res_id" ref="demo_lead_overdue"/>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="summary">Cyfr Demo Overdue Call</field>
        <field name="date_deadline" eval="(datetime.now() - timedelta(days=7)).date().isoformat()"/>
    </record>
</odoo>
